# Copy this file to .env only for local development. Production and staging
# values must be injected by the deployment platform's secret manager.

# Runtime identity
MASTERMIND_ENVIRONMENT=development
MASTERMIND_PRODUCT_NAME=Cipherboard
MASTERMIND_RELEASE=development
MASTERMIND_LOG_LEVEL=INFO
MASTERMIND_METRICS_ENABLED=true
MASTERMIND_ERROR_REPORTING_URL=
MASTERMIND_ERROR_REPORTING_TOKEN=

# API persistence. Local MongoDB runs as a replica set because room state and
# account deletion use transactions. Use a secret-manager URI in production.
MASTERMIND_MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0
MASTERMIND_MONGODB_DATABASE=mastermind
MASTERMIND_REDIS_URL=redis://localhost:6379/0

# First-party authentication. The signing key stays server-side. Mailpit is the
# default local SMTP sink and exposes its inbox at http://localhost:8025.
MASTERMIND_AUTH_ISSUER=http://localhost:8000
MASTERMIND_AUTH_AUDIENCE=cipherboard-web
MASTERMIND_AUTH_SIGNING_KEY=
MASTERMIND_AUTH_ACCESS_TOKEN_SECONDS=600
MASTERMIND_AUTH_REFRESH_TOKEN_DAYS=30
MASTERMIND_AUTH_EMAIL_TOKEN_SECONDS=900
MASTERMIND_AUTH_COOKIE_NAME=cipherboard_refresh
MASTERMIND_AUTH_COOKIE_SECURE=false
MASTERMIND_AUTH_COOKIE_SAMESITE=lax
MASTERMIND_AUTH_EMAIL_SENDER=Cipherboard <noreply@localhost.invalid>
MASTERMIND_SMTP_HOST=localhost
MASTERMIND_SMTP_PORT=1025
MASTERMIND_SMTP_USERNAME=
MASTERMIND_SMTP_PASSWORD=
MASTERMIND_SMTP_STARTTLS=false

# Application-layer secret protection. Generate local values with
# `infra/scripts/bootstrap-local-env.sh`. Never reuse local keys elsewhere.
MASTERMIND_SECRET_ENCRYPTION_KEYS=
MASTERMIND_SECRET_ACTIVE_KEY_VERSION=v1
MASTERMIND_DAILY_HMAC_KEY=
MASTERMIND_DAILY_HMAC_KEYS=
MASTERMIND_DAILY_HMAC_ACTIVE_KEY_VERSION=v1
MASTERMIND_PUBLIC_IDENTIFIER_HMAC_KEY=

# Exact browser/API origins. Pydantic parses the API setting as a JSON array.
MASTERMIND_ALLOWED_ORIGINS=["http://localhost:3000"]
MASTERMIND_PRODUCT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_PRODUCT_ORIGIN=http://localhost:3000

# Product configuration. The legal entity, jurisdiction, policy date, and a
# monitored support address are launch-blocking in production.
NEXT_PUBLIC_PRODUCT_NAME=Cipherboard
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_JURISDICTION=
NEXT_PUBLIC_POLICY_DATE=

# Operational controls
MASTERMIND_REQUEST_BODY_LIMIT_BYTES=65536
MASTERMIND_REQUEST_TIMEOUT_SECONDS=15
MASTERMIND_RATE_LIMIT_PER_MINUTE=120
MASTERMIND_ROOM_TIE_WINDOW_MS=250
MASTERMIND_WEBSOCKET_FRAME_LIMIT_BYTES=4096
MASTERMIND_WEBSOCKET_USER_CONNECTION_LIMIT=3
MASTERMIND_WEBSOCKET_IP_CONNECTION_LIMIT=20
MASTERMIND_WEBSOCKET_CONNECTION_TTL_SECONDS=90
MASTERMIND_TRUSTED_PROXY_IPS=[]
MASTERMIND_ADMIN_RECENT_AUTH_SECONDS=900
MASTERMIND_FEATURE_DAILY=true
MASTERMIND_FEATURE_LEADERBOARDS=true
MASTERMIND_FEATURE_FRIEND_CHALLENGES=true
MASTERMIND_FEATURE_MULTIPLAYER=true
MASTERMIND_FEATURE_ACHIEVEMENTS=true
MASTERMIND_FEATURE_ACCOUNT_REGISTRATION=true
MASTERMIND_FEATURE_ANALYTICS=false

# Production Compose/deployment inputs. Image references must be immutable
# digests, never `latest`; the release identifier is injected by the workflow.
API_IMAGE=
WEB_IMAGE=
RUNTIME_ENV_FILE=
API_HEALTH_URL=http://127.0.0.1:8000/health/ready
WEB_HEALTH_URL=http://127.0.0.1:3000/
