{
  "name": "mastermind-lab",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.18 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @mastermind/web dev",
    "dev:all": "docker compose up --build",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mastermind/web test:e2e",
    "test:a11y": "pnpm --filter @mastermind/web test:a11y",
    "test:load": "k6 run tests/load/gameplay.js",
    "generate:api": "pnpm --filter @mastermind/api-client generate",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "vite": "8.1.6"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "baseline-browser-mapping": "2.11.0",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "browserslist": "4.28.7",
      "js-yaml@^4.0.0": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "source-map-js": "1.2.2",
      "undici@^7.0.0": "7.30.1",
      "zod@^4.0.0": "4.6.6"
    }
  }
}
