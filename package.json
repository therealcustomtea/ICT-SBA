{
  "name": "mastermind-lab",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.18 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @mastermind/web dev",
    "dev:all": "docker compose up --build",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mastermind/web test:e2e",
    "test:a11y": "pnpm --filter @mastermind/web test:a11y",
    "test:load": "k6 run tests/load/gameplay.js",
    "generate:api": "pnpm --filter @mastermind/api-client generate",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  }
}
